        "name": "entry_form:tomo_processing",
        "definition": {"title": "Tomography Processing", "sections": [{"label": "General", "params": [{"id": "processing_path", "label": "PROCESSING path"}, {"id": "proc_label", "label": "", "default": "Select the the project path or a new one to be created. If it is a new project, the last folder in the path should not exist, the parent folder should exist and you should have writting permissions.", "type": "label"}, {"id": "data_path", "label": "DATA path"}, {"id": "data_label", "label": "", "default": "Select the path where the input RAW data is. A link 'data' will be created inside the project folder. In that way, all input files can be relative to the project root.", "type": "label"}]}, {"label": "Sharing", "params": [{"id": "share_table", "label": "Sharing Table", "type": "table", "columns": [{"id": "user_email", "label": "User email"}, {"id": "user_perms", "label": "Permissions", "enum": {"choices": ["view-only", "editor"], "display": "combo"}}], "min_rows": 4}]}], "config": {"show_title": true, "show_desc": true, "validate_func": "entry_tomo_processing_validate"}, "content": [{"func": "entry_tomo_processing_content"}]}
